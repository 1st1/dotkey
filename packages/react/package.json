{
  "name": "@dotkey/react",
  "version": "0.1.0",
  "description": "Render Apple Keynote (.key) presentations in React, including object builds and slide transitions.",
  "keywords": [
    "keynote",
    "iwork",
    "apple",
    "presentation",
    "slides",
    "react",
    "renderer",
    "viewer",
    "key"
  ],
  "license": "MIT",
  "author": "Yury Selivanov",
  "homepage": "https://github.com/1st1/dotkey#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1st1/dotkey.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/1st1/dotkey/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@dotkey/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  }
}
