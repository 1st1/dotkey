{
  "name": "dotkey",
  "private": true,
  "type": "module",
  "scripts": {
    "schema": "node tools/gen-schema.mjs",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm --filter @dotkey/demo dev",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "fonts": "node tools/gen-fonts.mjs",
    "release": "pnpm build && pnpm test && pnpm -r --filter \"./packages/*\" publish --access public",
    "release:dry": "pnpm -r --filter \"./packages/*\" publish --dry-run"
  },
  "devDependencies": {
    "protobufjs-cli": "^1.3.3",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "protobufjs": "^7.6.5"
  },
  "description": "Read Apple Keynote (.key) files in TypeScript and render them in React."
}
